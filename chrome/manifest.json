{
    "manifest_version": 3,
    "name": "GitIt",
    "description": "A badge with everything on GitHub that is waiting on you, and a dashboard listing it.",
    "version": "1.1",
    "author": "Ryan Gordon",
    "key": "",

    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_icon": {
            "16": "icons/toolbar-16.png",
            "32": "icons/toolbar-32.png"
        },
        "default_title": "GitIt",
        "default_popup": "popup.html"
    },

    "permissions": [ "nativeMessaging", "alarms", "storage", "tabs" ]
}
